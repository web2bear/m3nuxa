<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>../../src/ContexWin.Editor/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <ApplicationDefinition Include="../../src/ContexWin.Editor/App.xaml" Link="App.xaml" />
    <Page Include="../../src/ContexWin.Editor/Views/MainPage.xaml" Link="Views/MainPage.xaml" />
    <Compile Include="../../src/ContexWin.Editor/Views/MainPage.xaml.cs" Link="Views/MainPage.xaml.cs" />
    <Compile Include="../../src/ContexWin.Editor/Imports.cs" Link="Imports.cs" />
    <Compile Include="../../src/ContexWin.Editor/EditorPipeClient.cs" Link="EditorPipeClient.cs" />
    <Compile Include="../../src/ContexWin.Editor/IconFilePicker.cs" Link="IconFilePicker.cs" />
    <Compile Include="../../src/ContexWin.App/ConfigModels.cs" Link="ConfigModels.cs" />
    <Compile Include="../../src/ContexWin.App/DevLog.cs" Link="DevLog.cs" />
    <Compile Include="../../src/ContexWin.App/ItemIcon.cs" Link="ItemIcon.cs" />
  </ItemGroup>
</Project>


