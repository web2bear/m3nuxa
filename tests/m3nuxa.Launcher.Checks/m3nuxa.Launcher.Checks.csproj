<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>../../src/m3nuxa.App/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/m3nuxa.Editor/KeyboardCapture.cs" Link="KeyboardCapture.cs" />
    <EmbeddedResource Include="../../src/m3nuxa.App/Assets/TrayIcon.ico" LogicalName="m3nuxa.App.Assets.TrayIcon.ico" />
    <Compile Include="../../src/m3nuxa.App/*.cs" Exclude="../../src/m3nuxa.App/App.xaml.cs" />
    <ApplicationDefinition Include="../../src/m3nuxa.App/App.xaml" Link="App.xaml" />
    <Page Include="../../src/m3nuxa.App/LauncherMenu.xaml" Link="LauncherMenu.xaml" />

    <Content Include="../../assets/icon-packs/**/*" Link="icon-packs/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
</Project>
