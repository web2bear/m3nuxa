<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="m3nuxa.Editor.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="EditorBackgroundBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#171B22" Offset="0" /><GradientStop Color="#1B2028" Offset="0.55" /><GradientStop Color="#151A21" Offset="1" /></LinearGradientBrush>
                    <LinearGradientBrush x:Key="WorkspacePanelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1D222A" Offset="0" /><GradientStop Color="#1B2027" Offset="0.48" /><GradientStop Color="#1D222A" Offset="1" /></LinearGradientBrush>
                    <LinearGradientBrush x:Key="ToolbarSurfaceBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#292F37" Offset="0" /><GradientStop Color="#222830" Offset="1" /></LinearGradientBrush>
                    <SolidColorBrush x:Key="WorkspaceStrokeBrush" Color="#3C444D" />
                    <LinearGradientBrush x:Key="SectionBackgroundBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#242A32" Offset="0" /><GradientStop Color="#20262D" Offset="0.55" /><GradientStop Color="#242A32" Offset="1" /></LinearGradientBrush>
                    <SolidColorBrush x:Key="SectionStrokeBrush" Color="#3C444D" />
                    <SolidColorBrush x:Key="ToolbarGoldBrush" Color="#EAB84C" />
                    <SolidColorBrush x:Key="ToolbarBlueBrush" Color="#70BCEC" />
                    <SolidColorBrush x:Key="ToolbarGreenBrush" Color="#70C98C" />
                    <SolidColorBrush x:Key="ToolbarPurpleBrush" Color="#C68AF0" />
                    <SolidColorBrush x:Key="ToolbarGrayBrush" Color="#A9B4C4" />
                    <SolidColorBrush x:Key="ToolbarRedBrush" Color="#EC7777" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="EditorBackgroundBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F5F7F7" Offset="0" /><GradientStop Color="#E9EEEE" Offset="1" /></LinearGradientBrush>
                    <LinearGradientBrush x:Key="WorkspacePanelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#F5F8F8" Offset="1" /></LinearGradientBrush>
                    <LinearGradientBrush x:Key="ToolbarSurfaceBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#E8EEEE" Offset="1" /></LinearGradientBrush>
                    <SolidColorBrush x:Key="WorkspaceStrokeBrush" Color="#C5D1D1" />
                    <LinearGradientBrush x:Key="SectionBackgroundBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#F1F6F6" Offset="1" /></LinearGradientBrush>
                    <SolidColorBrush x:Key="SectionStrokeBrush" Color="#D4DEDE" />
                    <SolidColorBrush x:Key="ToolbarGoldBrush" Color="#8B5900" />
                    <SolidColorBrush x:Key="ToolbarBlueBrush" Color="#00629B" />
                    <SolidColorBrush x:Key="ToolbarGreenBrush" Color="#147038" />
                    <SolidColorBrush x:Key="ToolbarPurpleBrush" Color="#7536A0" />
                    <SolidColorBrush x:Key="ToolbarGrayBrush" Color="#505C6A" />
                    <SolidColorBrush x:Key="ToolbarRedBrush" Color="#B3262E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WorkspacePanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ToolbarSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WorkspaceStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SectionStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ToolbarGoldBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="ToolbarBlueBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="ToolbarGreenBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="ToolbarPurpleBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="ToolbarGrayBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="ToolbarRedBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="DeleteConfigurationButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource ToolbarRedBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="WorkflowSectionStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SectionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SectionStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style x:Key="WorkflowStepStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
            <DataTemplate x:Key="MenuTreeItemTemplate">
                <TreeViewItem Content="{Binding Content}" MinHeight="26" Padding="0,2" />
            </DataTemplate>
            <DataTemplate x:Key="ImportLabel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Import" />
                    <TextBlock Text="{Binding}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="SaveLabel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding}" />
                    <SymbolIcon Symbol="Save" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Background="{ThemeResource EditorBackgroundBrush}" RowDefinitions="Auto,*,Auto">
        <TitleBar x:Name="EditorTitleBar" Title="{x:Bind Localize('Editor_M3nuxaMenuEditor_652d6b')}" Margin="0,0,0,4">
            <TitleBar.IconSource><ImageIconSource ImageSource="ms-appx:///Assets/EditorIcon.ico" /></TitleBar.IconSource>
            <TitleBar.RightHeader>
                <ToggleButton x:Name="PinButton" AutomationProperties.AutomationId="PinButton"
                              AutomationProperties.Name="{x:Bind Localize('Editor_KeepTheEditorOnTop_3e7cbb')}"
                              ToolTipService.ToolTip="{x:Bind Localize('Editor_KeepTheEditorAboveOther_eb06b1')}"
                              Background="Transparent" BorderThickness="0" Click="PinClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Pin" />
                        <TextBlock Text="{x:Bind Localize('Editor_AlwaysOnTop_1bee89')}" />
                    </StackPanel>
                </ToggleButton>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="MenuPanel" Grid.Column="1" RowDefinitions="Auto,*,Auto" AllowDrop="True" Background="{ThemeResource WorkspacePanelBrush}" BorderBrush="{ThemeResource WorkspaceStrokeBrush}" BorderThickness="1" CornerRadius="12">
                <Grid Padding="8,6,8,4">
                    <DropDownButton x:Name="ConfigurationSelector" AutomationProperties.AutomationId="ConfigurationSelector" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind Localize('Editor_PrimaryConfiguration')}">
                        <DropDownButton.Flyout><MenuFlyout x:Name="ConfigurationsFlyout" Opening="ConfigurationsFlyoutOpening" /></DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
                <TreeView x:Name="MenuTree" Grid.Row="1" Margin="6,0,6,2" SelectionMode="Single"
                          CanDragItems="True" CanReorderItems="True" SelectionChanged="MenuTreeSelectionChanged"
                          ItemTemplate="{StaticResource MenuTreeItemTemplate}"
                          DragItemsStarting="MenuTreeDragItemsStarting" DragItemsCompleted="MenuTreeDragItemsCompleted" AllowDrop="True">
                    <TreeView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutSubItem Text="{x:Bind Localize('Workflow_Add')}">
                                <MenuFlyoutItem Text="{x:Bind Localize('Editor_Folder_72cf46')}" Click="AddFolderClicked" />
                                <MenuFlyoutItem Text="{x:Bind Localize('Editor_File_c1973e')}" Click="AddFileClicked" />
                                <MenuFlyoutItem Text="{x:Bind Localize('Editor_Action_4fe9c0')}" Click="AddActionClicked" />
                                <MenuFlyoutItem Text="{x:Bind Localize('Editor_Snippet_720dc5')}" Click="AddSnippetClicked" />
                                <MenuFlyoutItem Text="{x:Bind Localize('Editor_Group_ae8ad7')}" Click="AddGroupClicked" />
                                <MenuFlyoutItem Text="{x:Bind Localize('Editor_Separator_afb9a7')}" Click="AddSeparatorClicked" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CutButton" KeyboardAcceleratorTextOverride="Ctrl+X" Text="{x:Bind Localize('Editor_Cut_1b696e')}" Click="CutClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Cut" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CopyButton" KeyboardAcceleratorTextOverride="Ctrl+C" Text="{x:Bind Localize('Editor_Copy_4a05d8')}" Click="CopyClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="PasteButton" KeyboardAcceleratorTextOverride="Ctrl+Shift+V" Text="{x:Bind Localize('Editor_Insert_eeb8ca')}" Click="PasteClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Paste" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem KeyboardAcceleratorTextOverride="Ctrl+V" Text="{x:Bind Localize('Editor_InsertText_9ebca7')}" Click="PasteTextClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Paste" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="RenameButton" KeyboardAcceleratorTextOverride="F2" Text="{x:Bind Localize('Editor_Rename_715e8f')}" Click="RenameClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Rename" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="DuplicateButton" Text="{x:Bind Localize('Editor_Duplicate_c9a345')}" Click="DuplicateClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="DeleteButton" KeyboardAcceleratorTextOverride="Del" Text="{x:Bind Localize('Editor_Delete_86ea33')}" Click="DeleteClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        </MenuFlyout>
                    </TreeView.ContextFlyout>
                </TreeView>
                <Canvas x:Name="DropOverlay" Grid.Row="1" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border x:Name="DropIndicator" Visibility="Collapsed" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                </Canvas>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,4,8,6" Spacing="6">
                    <Button x:Name="ImportButton" AutomationProperties.AutomationId="ImportFolder" MinWidth="106"
                            Content="{x:Bind Localize('Editor_Import')}" ContentTemplate="{StaticResource ImportLabel}"
                            ToolTipService.ToolTip="{x:Bind Localize('Editor_ImportDesktop')}" Click="ImportFolderClicked" />
                    <Button x:Name="ApplyButton" AutomationProperties.AutomationId="ApplyButton" MinWidth="106"
                            Content="{x:Bind Localize('Editor_Apply_768af6')}" ContentTemplate="{StaticResource SaveLabel}"
                            Click="ApplyClicked" IsEnabled="False" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2" ColumnDefinitions="*,44">
            <Grid x:Name="DetailsPanel" RowDefinitions="Auto,*" Background="{ThemeResource WorkspacePanelBrush}" BorderBrush="{ThemeResource WorkspaceStrokeBrush}" BorderThickness="1" CornerRadius="12">
                <Grid Padding="10,6,10,4" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button x:Name="PropertiesIcon" VerticalAlignment="Center" Click="PropertiesIconClicked" AutomationProperties.Name="{x:Bind Localize('Icon_ChooseBundled')}" />
                    <SymbolIcon x:Name="ConfigurationPropertiesIcon" Symbol="Setting" Width="24" Height="24" Margin="8,4" VerticalAlignment="Center" Visibility="Collapsed" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Stretch" Spacing="0">
                        <TextBlock x:Name="PropertiesHint" Text="{x:Bind Localize('Editor_SelectAnItemOnThe_2c92bb')}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PropertiesType" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel>
                        <NavigationView x:Name="DetailsTabs" Margin="10,0,10,4" PaneDisplayMode="Top"
                                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
                                        SelectionFollowsFocus="Enabled" SelectionChanged="DetailsTabsSelectionChanged" Visibility="Collapsed">
                            <NavigationView.MenuItems>
                                <NavigationViewItem x:Name="DetailsSettingsItem" Content="{x:Bind Localize('Workflow_ItemSettings')}" Icon="Setting" />
                                <NavigationViewItem x:Name="DetailsStepsItem" Content="{x:Bind Localize('Workflow_Steps')}" Icon="List" />
                            </NavigationView.MenuItems>
                        </NavigationView>
                        <StackPanel x:Name="PropertiesPanel" Padding="10,2,10,10" Spacing="8" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="SourcePage" Visibility="Collapsed" ColumnDefinitions="320,*">
                <Grid x:Name="SourcePanel" RowDefinitions="Auto,*,Auto" AllowDrop="True" Background="{ThemeResource WorkspacePanelBrush}"
                      BorderBrush="{ThemeResource WorkspaceStrokeBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid Padding="8,6,8,4">
                        <DropDownButton x:Name="SourceSelector" AutomationProperties.AutomationId="SourceSelector" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind Localize('Editor_SecondConfiguration')}" Content="{x:Bind Localize('Editor_SelectSource')}">
                            <DropDownButton.Flyout><MenuFlyout x:Name="SourceFlyout" Opening="ConfigurationsFlyoutOpening" /></DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <TreeView x:Name="SourceTree" Grid.Row="1" Margin="6,0,6,2" SelectionMode="Single"
                              AutomationProperties.AutomationId="SourceTree" AutomationProperties.Name="{x:Bind Localize('Editor_SecondConfiguration')}"
                              ItemTemplate="{StaticResource MenuTreeItemTemplate}" CanDragItems="False" CanReorderItems="False">
                        <TreeView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="CopySourceItem" Text="{x:Bind Localize('Editor_CopyToPrimary')}" Click="CopySourceClicked" />
                            </MenuFlyout>
                        </TreeView.ContextFlyout>
                    </TreeView>
                    <Canvas x:Name="SourceDropOverlay" Grid.Row="1" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border x:Name="SourceDropIndicator" Visibility="Collapsed" CornerRadius="2" />
                    </Canvas>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,4,8,6" Spacing="6">
                        <Button x:Name="SourceImportButton" AutomationProperties.AutomationId="SourceImportFolder" MinWidth="106"
                                Content="{x:Bind Localize('Editor_Import')}" ContentTemplate="{StaticResource ImportLabel}"
                                ToolTipService.ToolTip="{x:Bind Localize('Editor_ImportDesktop')}" Click="ImportFolderClicked" IsEnabled="False" />
                        <Button x:Name="SourceSaveButton" AutomationProperties.AutomationId="SourceSaveButton" MinWidth="106"
                                Content="{x:Bind Localize('Editor_Apply_768af6')}" ContentTemplate="{StaticResource SaveLabel}"
                                Click="SourceSaveClicked" IsEnabled="False" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Column="1" Margin="10,10,8,0" VerticalAlignment="Top" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Localize('Editor_SourceExplanation')}" />
            </Grid>
            <Canvas Grid.Column="1" Margin="0,8,0,0">
                <SelectorBar x:Name="WorkspaceTabs" Canvas.Left="44" SelectionChanged="WorkspaceTabsChanged">
                    <SelectorBar.RenderTransform><RotateTransform Angle="90" /></SelectorBar.RenderTransform>
                    <SelectorBarItem x:Name="PropertiesTab" AutomationProperties.AutomationId="PropertiesTab"
                                     Text="{x:Bind Localize('Editor_PropertiesTab')}" />
                    <SelectorBarItem x:Name="SourceTab" AutomationProperties.AutomationId="SourceTab"
                                     Text="{x:Bind Localize('Editor_SecondConfiguration')}" />
                </SelectorBar>
            </Canvas>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Margin="12,0,12,0" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsContents" Padding="14,10" Spacing="10" MaxWidth="680" HorizontalAlignment="Left" />
        </ScrollViewer>
        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="12,6" Severity="Informational" />
    </Grid>
</Page>
