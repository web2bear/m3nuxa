<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="m3nuxa.Editor.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Padding="16,6,16,4">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="m3nuxa" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <MenuBar VerticalAlignment="Center">
                    <MenuBarItem Title="Файл">
                        <MenuFlyoutItem x:Name="ApplyMenuItem" Text="Применить" IsEnabled="False" Click="ApplyClicked" />
                        <MenuFlyoutItem Text="Загрузить конфигурацию…" Click="LoadClicked" />
                        <MenuFlyoutItem Text="Перезагрузить" Click="ReloadClicked" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Сохранить черновик отдельно…" Click="SaveClicked" />
                    </MenuBarItem>
                    <MenuBarItem Title="Правка">
                        <MenuFlyoutItem Text="Отменить" Click="UndoClicked" />
                        <MenuFlyoutItem Text="Повторить" Click="RedoClicked" />
                    </MenuBarItem>
                </MenuBar>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="8,0,8,4" ColumnDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal">
                <AppBarButton Icon="Add" Label="Создать" AutomationProperties.Name="Создать пункт меню">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Папка…" Click="AddFolderClicked" />
                            <MenuFlyoutItem Text="Файл…" Click="AddFileClicked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Действие" Click="AddActionClicked" />
                            <MenuFlyoutItem Text="Сниппет" Click="AddSnippetClicked" />
                            <MenuFlyoutItem Text="Группа" Click="AddGroupClicked" />
                            <MenuFlyoutItem Text="Разделитель" Click="AddSeparatorClicked" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="ApplyButton" Icon="Accept" Label="Применить" IsEnabled="False" ToolTipService.ToolTip="Нет изменений для применения" Click="ApplyClicked" />
                <AppBarToggleButton x:Name="PinButton" Icon="Pin" Label="Поверх окон" AutomationProperties.Name="Закрепить редактор поверх окон" ToolTipService.ToolTip="Закрепить редактор поверх других окон" Click="PinClicked" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Auto">
                <AppBarButton x:Name="CutButton" Icon="Cut" Label="Вырезать" Click="CutClicked" />
                <AppBarButton x:Name="CopyButton" Icon="Copy" Label="Копировать" Click="CopyClicked" />
                <AppBarButton Icon="Paste" Label="Вставить текст" AutomationProperties.Name="Создать сниппет из буфера обмена" Click="PasteTextClicked" />
                <AppBarButton x:Name="PasteButton" Icon="Paste" Label="Вставить" Click="PasteClicked" />
                <AppBarButton x:Name="RenameButton" Icon="Rename" Label="Переименовать" Click="RenameClicked" />
                <AppBarButton x:Name="DuplicateButton" Icon="Copy" Label="Дублировать" Click="DuplicateClicked" />
                <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="Удалить" Click="DeleteClicked" />
                <AppBarSeparator />
                <AppBarButton Icon="Setting" Label="Настройки" AutomationProperties.AutomationId="OpenSettings" Click="SettingsClicked" />
            </CommandBar>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" Padding="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="MenuPanel" Grid.Column="0" RowDefinitions="Auto,*,Auto" AllowDrop="True" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel Padding="12,10,12,6" Spacing="4">
                    <TextBlock Text="Порядок и вложенность пунктов" Opacity="0.6" FontSize="12" />
                </StackPanel>
                <TreeView x:Name="MenuTree" Grid.Row="1" Margin="8,2,8,4" SelectionMode="Single"
                          CanDragItems="True" CanReorderItems="True" SelectionChanged="MenuTreeSelectionChanged"
                          DragItemsStarting="MenuTreeDragItemsStarting" DragItemsCompleted="MenuTreeDragItemsCompleted" AllowDrop="True">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TreeViewItem Content="{Binding Content}" />
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Дублировать" Click="DuplicateClicked" />
                            <MenuFlyoutItem Text="Удалить" Click="DeleteClicked" />
                        </MenuFlyout>
                    </TreeView.ContextFlyout>
                </TreeView>
                <TextBlock Grid.Row="2" x:Name="DropHint" Margin="12,6,12,10" Text="Перетащите файлы, папки или текст сюда" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            </Grid>
            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Grid x:Name="DetailsPanel" Grid.Column="2" RowDefinitions="Auto,*" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel Padding="14,10,14,6" Spacing="3">
                    <TextBlock x:Name="PropertiesHint" Text="Выберите пункт слева" FontSize="12" Opacity="0.6" />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="PropertiesPanel" Padding="14,2,14,14" Spacing="10" MaxWidth="680" HorizontalAlignment="Left" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="3" IsOpen="False" IsClosable="True" Margin="20,12" Severity="Informational" />
    </Grid>
</Page>
