<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="m3nuxa.Editor.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Padding="16,6,16,4">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="m3nuxa" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <MenuBar VerticalAlignment="Center">
                    <MenuBarItem Title="{x:Bind Localize('Editor_File_94b8df')}">
                        <MenuFlyoutItem x:Name="ApplyMenuItem" Text="{x:Bind Localize('Editor_Apply_768af6')}" IsEnabled="False" Click="ApplyClicked" />
                        <MenuFlyoutItem Text="{x:Bind Localize('Editor_LoadConfiguration_0439e7')}" Click="LoadClicked" />
                        <MenuFlyoutItem Text="{x:Bind Localize('Editor_Reload_942438')}" Click="ReloadClicked" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="{x:Bind Localize('Editor_SaveDraftSeparately_23cefc')}" Click="SaveClicked" />
                    </MenuBarItem>
                    <MenuBarItem Title="{x:Bind Localize('Editor_Edit_1f62f0')}">
                        <MenuFlyoutItem Text="{x:Bind Localize('Editor_Undo_555ad1')}" Click="UndoClicked" />
                        <MenuFlyoutItem Text="{x:Bind Localize('Editor_Redo_9e506a')}" Click="RedoClicked" />
                    </MenuBarItem>
                </MenuBar>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="8,0,8,4" ColumnDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal">
                <AppBarButton Icon="Add" Label="{x:Bind Localize('Editor_Create_84370a')}" AutomationProperties.Name="{x:Bind Localize('Editor_CreateMenuItem_b78a7d')}">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind Localize('Editor_Folder_72cf46')}" Click="AddFolderClicked" />
                            <MenuFlyoutItem Text="{x:Bind Localize('Editor_File_c1973e')}" Click="AddFileClicked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind Localize('Editor_Action_4fe9c0')}" Click="AddActionClicked" />
                            <MenuFlyoutItem Text="{x:Bind Localize('Editor_Snippet_720dc5')}" Click="AddSnippetClicked" />
                            <MenuFlyoutItem Text="{x:Bind Localize('Editor_Group_ae8ad7')}" Click="AddGroupClicked" />
                            <MenuFlyoutItem Text="{x:Bind Localize('Editor_Separator_afb9a7')}" Click="AddSeparatorClicked" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="ApplyButton" Icon="Accept" Label="{x:Bind Localize('Editor_Apply_768af6')}" IsEnabled="False" ToolTipService.ToolTip="{x:Bind Localize('Editor_NoChangesToApply_fefed9')}" Click="ApplyClicked" />
                <AppBarToggleButton x:Name="PinButton" Icon="Pin" Label="{x:Bind Localize('Editor_AlwaysOnTop_1bee89')}" AutomationProperties.Name="{x:Bind Localize('Editor_KeepTheEditorOnTop_3e7cbb')}" ToolTipService.ToolTip="{x:Bind Localize('Editor_KeepTheEditorAboveOther_eb06b1')}" Click="PinClicked" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Auto">
                <AppBarButton x:Name="CutButton" Icon="Cut" Label="{x:Bind Localize('Editor_Cut_1b696e')}" Click="CutClicked" />
                <AppBarButton x:Name="CopyButton" Icon="Copy" Label="{x:Bind Localize('Editor_Copy_4a05d8')}" Click="CopyClicked" />
                <AppBarButton Icon="Paste" Label="{x:Bind Localize('Editor_InsertText_9ebca7')}" AutomationProperties.Name="{x:Bind Localize('Editor_CreateASnippetFromThe_f97cea')}" Click="PasteTextClicked" />
                <AppBarButton x:Name="PasteButton" Icon="Paste" Label="{x:Bind Localize('Editor_Insert_eeb8ca')}" Click="PasteClicked" />
                <AppBarButton x:Name="RenameButton" Icon="Rename" Label="{x:Bind Localize('Editor_Rename_715e8f')}" Click="RenameClicked" />
                <AppBarButton x:Name="DuplicateButton" Icon="Copy" Label="{x:Bind Localize('Editor_Duplicate_c9a345')}" Click="DuplicateClicked" />
                <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="{x:Bind Localize('Editor_Delete_86ea33')}" Click="DeleteClicked" />
                <AppBarSeparator />
                <AppBarButton Icon="Setting" Label="{x:Bind Localize('Editor_Settings_7f17c7')}" AutomationProperties.AutomationId="OpenSettings" Click="SettingsClicked" />
            </CommandBar>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" Padding="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="MenuPanel" Grid.Column="0" RowDefinitions="Auto,*,Auto" AllowDrop="True" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel Padding="12,10,12,6" Spacing="4">
                    <TextBlock Text="{x:Bind Localize('Editor_ItemOrderAndHierarchy_0718c3')}" Opacity="0.6" FontSize="12" />
                </StackPanel>
                <TreeView x:Name="MenuTree" Grid.Row="1" Margin="8,2,8,4" SelectionMode="Single"
                          CanDragItems="True" CanReorderItems="True" SelectionChanged="MenuTreeSelectionChanged"
                          DragItemsStarting="MenuTreeDragItemsStarting" DragItemsCompleted="MenuTreeDragItemsCompleted" AllowDrop="True">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TreeViewItem Content="{Binding Content}" />
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind Localize('Editor_Duplicate_c9a345')}" Click="DuplicateClicked" />
                            <MenuFlyoutItem Text="{x:Bind Localize('Editor_Delete_86ea33')}" Click="DeleteClicked" />
                        </MenuFlyout>
                    </TreeView.ContextFlyout>
                </TreeView>
                <TextBlock Grid.Row="2" x:Name="DropHint" Margin="12,6,12,10" Text="{x:Bind Localize('Editor_DragFilesFoldersOrText_2e21d1')}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            </Grid>
            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Grid x:Name="DetailsPanel" Grid.Column="2" RowDefinitions="Auto,*" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <StackPanel Padding="14,10,14,6" Spacing="3">
                    <TextBlock x:Name="PropertiesHint" Text="{x:Bind Localize('Editor_SelectAnItemOnThe_2c92bb')}" FontSize="12" Opacity="0.6" />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="PropertiesPanel" Padding="14,2,14,14" Spacing="10" MaxWidth="680" HorizontalAlignment="Left" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="3" IsOpen="False" IsClosable="True" Margin="20,12" Severity="Informational" />
    </Grid>
</Page>
